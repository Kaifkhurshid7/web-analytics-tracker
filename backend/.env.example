# Backend Configuration

# Server port
PORT=4000

# MongoDB connection URI
# Local: mongodb://localhost:27017/analytics
# Docker: mongodb://admin:admin@mongodb:27017/analytics?authSource=admin
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/analytics
MONGODB_URI=mongodb://localhost:27017/analytics

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Optional: API rate limiting (requests per minute)
# RATE_LIMIT=100

# Optional: JWT secret for future authentication
# JWT_SECRET=your-secret-key-here

